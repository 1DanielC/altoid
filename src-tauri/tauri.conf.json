{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Openspace Sync",
  "version": "0.1.0",
  "identifier": "openspace.ai.altoid",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenSpace Desktop Sync",
        "width": 500,
        "height": 700,
        "minWidth": 350,
        "minHeight": 350,
        "maxWidth": 500,
        "maxHeight": 700,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/os-cube-150.png",
      "icons/os-cube-white-150.png"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  }
}
